# Copy to .env. Never commit .env.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Silent Partner vault contract
VAULT_CONTRACT_ID=
# Operator: NEAR account + key that posts NAV / mints / burns (testnet faucet account)
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=
# Ed25519 key of the vault's confidential intents account (operator-held; see docs/DECISIONS.md D-P1a)
VAULT_INTENTS_PRIVATE_KEY=
# 1Click partner JWT (sent as X-API-Key, 20 bps)
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# Never set to 0 without Amit's explicit OK: 1 = dry quotes only, nothing signed or submitted
DRY_RUN=1
DATA_DIR=./data
PORT=8788
